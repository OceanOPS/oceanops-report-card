# Copy to mode-specific files (all `*.local` are gitignored).
#
# Local dev — map on localhost:5174:
#   cp .env.example .env.development.local
#   (use the development block below)
#
# Test deploy — Netlify preview map in production build:
#   create `.env.production.local` with your preview URL (wins over `.env.production`)
#
# Do NOT put VITE_MAP_SRC in `.env.local` — Vite loads that file for dev AND build.

# --- .env.development.local (npm run dev only) ---
# VITE_MAP_SRC=http://localhost:5174/demos/simple-arcgis-map/

# --- .env.production.local (npm run build only; optional) ---
# VITE_MAP_SRC=https://YOUR-DEPLOY--oceanops-simple-map-t.netlify.app/demos/simple-arcgis-map/

# Committed default for production builds: see `.env.production`
